# Copy sang .env (KHONG commit file .env that)
# Local: PORT=4000. Render tu dat PORT, khong can sua.
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me
DATABASE_PATH=./data/app.db
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Key Gemini de nhan dien de thi bang AI (POST /api/admin/test-sets/:id/ai-parse).
# Lay key o Google AI Studio (https://aistudio.google.com/apikey).
# Chi can key, khong can Client Secret. Chua co key thi endpoint tra 501.
GEMINI_API_KEY=
# Cloudinary de luu anh/audio cho phan Nghe (xem README muc "Anh + Audio").
# Lay Cloud name o dashboard Cloudinary; Upload preset la preset unsigned
# tu tao o Settings -> Upload -> Upload presets. Chua co 2 bien nay thi
# endpoint media tra 501, app van chay binh thuong.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# URL frontend duoc phep goi API (co the ghi nhieu URL, cach nhau bang dau phay).
# Local: http://localhost:5173 (da mac dinh cho phep, khong can ghi).
# Khi deploy: dien URL Vercel that, vd https://app-toeic.vercel.app
FRONTEND_URL=
# CORS_ORIGIN: ten cu cua FRONTEND_URL, van duoc ho tro de tuong thich nguoc.
CORS_ORIGIN=http://localhost:5173
